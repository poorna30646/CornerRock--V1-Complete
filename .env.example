# Copy this file to .env.local for local development. Do not commit .env.local
# or .env.production. Configure these values in AWS Amplify for each branch.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# SMTP Configuration for Nodemailer (for sending emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Company notification email (where leads are sent)
COMPANY_NOTIFICATION_EMAIL=your-notification-email@example.com

# Public site URL (used for metadata and OpenGraph). In Amplify, use the active
# branch's HTTPS Amplify URL until the custom domain is connected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business Number (for contact integration)
# This is used in the WhatsApp widget - format: country_code + phone_number without + sign
# Example: 15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
